


@model AURA.Models.ViewModelAo


@{
    ViewBag.Title = "Áo – Tổng Hợp";
    Layout = "~/Views/Shared/_AURALayout.cshtml";
}

<link rel="stylesheet" href="~/Content/Màu_GU/Gu.css" />

<div class="ao-page">
    <div class="container">

        <h1 class="page-title">
            Khám Phá Áo Thời Trang Của Bạn
        </h1>

        <!-- 3 LOẠI ÁO CẤP 1 -->
        <div class="brand-container">

            <div class="brand-box">
                <a href="@Url.Action("DanhMuc", "Ao", new { id = 1 })">
                    <img src="~/Content/images/_MENU/Áo/1_a2316c4b-6274-4d3c-8e44-1b4f97c476ef.webp" alt="Áo Thun" />
                </a>
            </div>

            <div class="brand-box">
                <a href="@Url.Action("DanhMuc", "Ao", new { id = 2 })">
                    <img src="~/Content/images/_MENU/Áo/2_7f3d8fcc-30df-4750-9c88-26f3d5c0c828.webp" alt="Áo Sơ Mi" />
                </a>
            </div>

            <div class="brand-box">
                <a href="@Url.Action("DanhMuc", "Ao", new { id = 3 })">
                    <img src="~/Content/images/_MENU/Áo/3_381bf279-f946-42a9-8178-b2ac575a3b62.webp" alt="Áo Khoác" />
                </a>
            </div>

        </div>


        <!-- BỘ LỌC -->
        <div class="filter-container">
            <span class="label">Bộ lọc:</span>

            <!-- LỌC GIÁ -->
            <div class="filter-box">
                <button class="filter-trigger">Giá ▾</button>
                <ul class="filter-menu price-filter">
                    <li data-price="100">Dưới 100K</li>
                    <li data-price="200">100K - 200K</li>
                    <li data-price="300">200K - 300K</li>
                    <li data-price="400">Trên 300K</li>
                </ul>
            </div>

            <!-- LỌC MÀU -->
            <div class="filter-box">
                <button class="filter-trigger">Màu ▾</button>
                <ul class="filter-menu color-filter">
                    <li data-color="đen"><span class="color-dot black"></span> Đen</li>
                    <li data-color="trắng"><span class="color-dot white"></span> Trắng</li>
                    <li data-color="xám"><span class="color-dot gray"></span> Xám</li>
                    <li data-color="xanh"><span class="color-dot blue"></span> Xanh</li>
                    <li data-color="nâu"><span class="color-dot" style="background:brown"></span> Nâu</li>
                </ul>
            </div>

        </div>


        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="product-list">

            @foreach (var sp in Model.DSSanPham)
            {
                <div class="product"
                     data-color="@sp.MauSac.ToLower()"
                     data-gia="@sp.Gia">

                    <div class="img-box">
                        <a href="@Url.Action("Index", "ChiTietSanPhamAo", new { id = sp.MaSP })">
                            <img src="@sp.HinhAnh" alt="@sp.TenSP" />

                            <div class="overlay"></div>
                            <span class="tag">Miễn Phí Ship</span>

                            <p class="name">@sp.TenSP</p>

                            <p class="old-price">@String.Format("{0:N0}", sp.GiaGoc) VND</p>
                            <p class="price">@String.Format("{0:N0}", sp.Gia) VND</p>
                        </a>
                    </div>
                </div>
            }

        </div>

    </div>
</div>

<div class="pagination">
    <ul>

        @if (Model.CurrentPage > 1)
        {
            <li><a href="@Url.Action("AoMenu", new { page = Model.CurrentPage - 1 })">‹ Prev</a></li>
        }
        else
        {
            <li class="disabled">‹ Prev</li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.CurrentPage)
            {
                <li class="active">@i</li>
            }
            else
            {
                <li><a href="@Url.Action("AoMenu", new { page = i })">@i</a></li>
            }
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li><a href="@Url.Action("AoMenu", new { page = Model.CurrentPage + 1 })">Next ›</a></li>
        }
        else
        {
            <li class="disabled">Next ›</li>
        }

    </ul>
</div>




<script src="~/Scripts/Menu-Gu/Gu.js"></script>

