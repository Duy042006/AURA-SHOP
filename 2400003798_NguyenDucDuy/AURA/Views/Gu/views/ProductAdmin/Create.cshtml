@model AURA.Models.SanPham

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AURALayout.cshtml";
}

<link rel="stylesheet" href="~/Content/Màu_User/ProductAdmin.css" />

<div class="admin-container">

    <div class="admin-title">
        ➕ THÊM SẢN PHẨM
    </div>

    @using (Html.BeginForm("Create", "ProductAdmin", FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Tên sản phẩm</label>
            @Html.TextBoxFor(m => m.TenSP, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            <label>Giá</label>
            @Html.TextBoxFor(m => m.Gia, new { @class = "form-control", type = "number", required = "required" })
        </div>

        <div class="form-group">
            <label>Giá gốc</label>
            @Html.TextBoxFor(m => m.GiaGoc, new { @class = "form-control", type = "number" })
        </div>

        <div class="form-group">
            <label>Màu sắc</label>
            @Html.TextBoxFor(m => m.MauSac, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Chọn ảnh từ máy</label>
            <input type="file" name="fileAnh" class="form-control" accept="image/*" required />
        </div>

        <div class="form-group">
            <label>Mô tả</label>
            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 4 })
        </div>

        <div class="admin-buttons">
            <button type="submit" class="btn-success">
                ✅ Lưu sản phẩm
            </button>

            <a href="@Url.Action("Index", "ProductAdmin")" class="btn-secondary">
                ⬅ Quay lại
            </a>
        </div>
    }

</div>
