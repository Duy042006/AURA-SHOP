@model AURA.ViewModels.TrangChuViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AURALayout.cshtml";
}

<link rel="stylesheet" href="~/Content/Mau_Trang_Chu/Trang_chu.css" />

@{
    var u = Session["User"];
}

<section class="model-banner">
    <img src="https://yame.vn/cdn/shop/files/banner_homepage_0111_pc.jpg?v=1761993005&width=2000"
         alt="Ảnh người mẫu" />
</section>

<main>
    <!-- Thanh chạy MIỄN PHÍ SHIP -->
    <div class="marquee">
        <div class="marquee-content">
            @for (int i = 0; i < 16; i++)
            {
                <span>MIỄN PHÍ SHIP</span>
            }
        </div>
    </div>

    <!-- Khu vực sản phẩm -->
    <!-- Trạm 1 -->
    <section class="station">
        <h2>Trạm 1 | Thời Trang Thiết Yếu</h2>
        <p>"Nền Tảng Phong Cách, Chất Lượng Vượt Thời Gian"</p>

        <div class="product-list">
            @foreach (var sp in Model.SanPhams.Take(4))
            {
                <div class="product">
                    <div class="img-box">
                        <a href="@Url.Action("Index", "ChiTietSanPhamTrangChu", new { id = sp.Id })">
                            <img src="@Url.Content(sp.HinhAnh)" alt="@sp.TenSanPham" width="200" />

                            <div class="overlay"></div>
                            <span class="tag">Miễn Phí Ship</span>
                            <p class="name">@sp.TenSanPham</p>
                            <p class="old-price">@String.Format("{0:N0}", sp.GiaGoc) VND</p>
                            <p class="price">@String.Format("{0:N0}", sp.Gia) VND</p>
                        </a>
                    </div>
                </div>
            }
        </div>

        <a href="@Url.Action("Nhom", "Gu", new { id = 1 })"><button class="see-all">Xem tất cả</button></a>
    </section>

    <!-- Khu vực hiển thị 12 ảnh -->
    <div class="gallery">

        <div class="image-group">
            @foreach (var img in Model.Gallery.Take(7))
            {
                <a href="#" class="img-item"><img src="@img.HinhAnh" /></a>
            }

            @foreach (var img in Model.Gallery.Skip(7).Take(7))
            {
                <a href="#" class="img-item hidden"><img src="@img.HinhAnh" /></a>
            }
        </div>

        <a href="#" class="see-more">Xem thêm</a>

    </div>

