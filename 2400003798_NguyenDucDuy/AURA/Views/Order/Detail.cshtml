@model AURA.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    var items = (List<AURA.Models.OrderDetail>)ViewBag.Items;
    Layout = "~/Views/Shared/_AURALayout.cshtml";
}

<link rel="stylesheet" href="~/Content/Màu_User/OrderDetail.css" />

<div class="order-detail-wrapper">

    <h2 class="order-title">Chi tiết đơn hàng #@Model.OrderID</h2>

    <div class="order-info">
        <p><b>Ngày đặt:</b> @Model.OrderDate</p>
        <p><b>Trạng thái:</b> @Model.Status</p>
        <p><b>Tổng tiền:</b> @String.Format("{0:N0} đ", Model.TotalAmount)</p>
    </div>

    <h3>Danh sách sản phẩm</h3>

    <table class="order-detail-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Tạm tính</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@String.Format("{0:N0} đ", item.Price)</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:N0} đ", item.Price * item.Quantity)</td>
                </tr>
            }
        </tbody>
    </table>

    <a href="@Url.Action("Index", "Order")" class="btn-back">← Quay lại</a>

</div>
