    @model AURA.Models.User
    @{
        Layout = null;
    }

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Login</title>

        <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
        <link rel="stylesheet" href="/Content/Màu_Login/Login.css" />
    </head>

    <body>
        <div class="wrapper">
            @using (Html.BeginForm("Index", "Login", FormMethod.Post))
            {
                <h1>Login</h1>

                <div class="input-box">
                    @Html.TextBox("Username", null, new { placeholder = "Username" })
                    <i class='bx bxs-user'></i>
                </div>

                <div class="input-box">
                    @Html.Password("Password", null, new { placeholder = "Password" })
                    <i class='bx bxs-lock-alt'></i>
                </div>

                <div class="remember-forgot">
                    <label><input type="checkbox"> Remember me</label>
                    <a href="#">Forgot password?</a>
                </div>

                <button type="submit" class="btn">Login</button>

                <div class="register-link">
                    <p>Bạn chưa có tài khoản? <a href="@Url.Action("Index","Sign_up")">Đăng ký</a></p>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <p style="color:red; margin-bottom:10px">@ViewBag.Error</p>
            }

          
        </div>
    </body>
    </html>
