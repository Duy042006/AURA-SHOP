@model AURA.Models.DonHangViewModel

@{
    ViewBag.Title = "ThanhToan";
    Layout = "~/Views/Shared/_AURALayout.cshtml";


    // =========================
    // TÍNH TOÁN THANH TOÁN
    // =========================
    decimal tongTien = 0;
    if (Model != null && Model.GioHang != null)
    {
        tongTien = Model.GioHang.Sum(x => x.ThanhTien);
    }

    bool daDangNhap = Session["User"] != null;
    decimal giamGia = daDangNhap ? tongTien * 0.1m : 0;   // giảm 10% cho thành viên
    decimal thanhToan = tongTien - giamGia;
}

<link rel="stylesheet" href="~/Content/Màu_GioHang/ThanhToan.css" />

<div class="thanhtoan-container">

    <div class="thanhtoan-title">📝 THÔNG TIN THANH TOÁN</div>

    @if (Model == null || Model.GioHang == null || !Model.GioHang.Any())
    {
        <h3 style="text-align:center; color:red;">❌ Giỏ hàng trống</h3>
        <div style="text-align:center;">
            <a href="@Url.Action("Index","TrangChu")">⬅️ Quay về mua hàng</a>
        </div>
    }
    else
    {
        <form action="@Url.Action("ThanhToan", "GioHang")" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <!-- ========================= -->
            <!-- FORM THÔNG TIN KHÁCH HÀNG -->
            <!-- ========================= -->
            <div class="thanhtoan-form">

                <div>
                    <label>Họ tên</label>
                    <input type="text"
                           name="HoTen"
                           value="@(Model.HoTen ?? "")"
                           placeholder="Nhập họ tên"
                           required />
                </div>

                <div>
                    <label>Số điện thoại</label>
                    <input type="text"
                           name="DienThoai"
                           value="@(Model.DienThoai ?? "")"
                           placeholder="Nhập số điện thoại"
                           required />
                </div>

                <div>
                    <label>Địa chỉ</label>
                    <input type="text"
                           name="DiaChi"
                           value="@(Model.DiaChi ?? "")"
                           placeholder="Nhập địa chỉ"
                           required />
                </div>

                <div>
                    <label>Ghi chú</label>
                    <textarea name="GhiChu"
                              placeholder="Nhập ghi chú (nếu có)">@(Model.GhiChu ?? "")</textarea>
                </div>

            </div>

            <!-- ========================= -->
            <!-- BẢNG SẢN PHẨM -->
            <!-- ========================= -->
            <table class="thanhtoan-table">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>

                @foreach (var item in Model.GioHang)
                {
                    <tr>
                        <td>@item.TenSP</td>
                        <td>@item.SoLuong</td>
                        <td>@String.Format("{0:N0} đ", item.ThanhTien)</td>
                    </tr>
                }
            </table>

            <!-- ========================= -->
            <!-- TỔNG TIỀN + ƯU ĐÃI -->
            <!-- ========================= -->
            <div class="tt-total">

                <p>
                    Tạm tính:
                    <strong>@String.Format("{0:N0} đ", tongTien)</strong>
                </p>

                @if (daDangNhap)
                {
                    <p style="color:green;">
                        🎉 Ưu đãi thành viên (−10%):
                        −@String.Format("{0:N0} đ", giamGia)
                    </p>
                }
                else
                {
                    <p style="color:#888;">
                        👉 Đăng nhập để nhận ưu đãi thành viên
                    </p>
                }

                <hr />

                <p style="font-size:18px;">
                    <b>Tổng thanh toán:</b>
                    <span style="color:#e53935; font-weight:bold;">
                        @String.Format("{0:N0} đ", thanhToan)
                    </span>
                </p>

            </div>

            <!-- ========================= -->
            <!-- NÚT ĐẶT HÀNG -->
            <!-- ========================= -->
            <div class="tt-btn">
                <button type="submit">
                    ✅ XÁC NHẬN ĐẶT HÀNG
                </button>
            </div>

        </form>
    }

</div>
